# Copie para .env com `make env`, que preenche as senhas com valores aleatórios.
# Nunca coloque valores reais neste arquivo. URLs de banco e Redis são montadas no docker-compose.

# --- Segredos locais (preenchidos por `make env`) ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
INGEST_DB_PASSWORD=
REDIS_PASSWORD=

# --- Aplicação ---
APP_ENV=dev
LOG_LEVEL=INFO
READY_TIMEOUT_SECONDS=2
# Front e API no mesmo host (proxy reverso); CORS só para origens extras, em JSON.
CORS_ALLOWED_ORIGINS=[]
HEARTBEAT_FILE=/tmp/heartbeat
HEARTBEAT_INTERVAL_SECONDS=10

# --- Fora do docker-compose (ex.: testes rodando direto no host) ---
# DATABASE_URL=postgresql+asyncpg://telemetria_app:<senha>@localhost:5432/telemetria
# INGEST_DATABASE_URL=postgresql+asyncpg://telemetria_ingest:<senha>@localhost:5432/telemetria
# MIGRATION_DATABASE_URL=postgresql+asyncpg://telemetria_owner:<senha>@localhost:5432/telemetria
# REDIS_URL=redis://:<senha>@localhost:6379/0
